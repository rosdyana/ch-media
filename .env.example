# CH Media Service
PORT=4020
HOST=0.0.0.0
# Shared secret required by CHBackend (Authorization: Bearer <token>). Leave empty to disable auth (dev only).
MEDIA_SERVICE_TOKEN="change-me-shared-secret"

# --- Binaries (installed on THIS host / image only) ---
YTDLP_PATH="yt-dlp"
FFMPEG_PATH="ffmpeg"
# whisper.cpp CLI (whisper-cli or main) + a ggml/gguf model file
WHISPER_CPP_PATH="whisper-cli"
WHISPER_MODEL_PATH="/opt/whisper/models/ggml-small.bin"

# --- Upload Rule
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_EXTENSIONS=.mp3,.wav,.m4a,.ogg,.webm,.flac
UPLOAD_ALLOWED_MIMETYPES=audio/mpeg,audio/mp3,audio/wav,audio/x-wav,audio/wave,audio/vnd.wave,audio/mp4,audio/x-m4a,audio/ogg,application/ogg,audio/webm,audio/flac,audio/x-flac
UPLOAD_FFMPEG_TIMEOUT_MS=300000

# --- ASR fallback (Whisper) ---
# NOTE: the Docker image sets ASR_ENABLED=true in its own ENV, but docker-compose
# loads this file via env_file, which WINS over the image ENV — so leaving "false"
# here silently disables ASR in the container too.
ASR_ENABLED="false"          # set "true" once whisper + model are installed
ASR_CONCURRENCY="1"          # simultaneous transcriptions (CPU/GPU bound)
ASR_TIMEOUT_MS="1800000"     # 30 min per transcription
ASR_LANG="auto"              # last-resort Whisper language; a caption/metadata language is
                             # preferred per-video, since "auto" detects from only the first
                             # 30s window (it tagged an English video as Arabic in production)
# Refuse ASR for audio longer than this *before* downloading it: audio we can't finish costs
# the entire ASR_TIMEOUT_MS and returns nothing. 1200s suits large-v3-turbo on ~2 CPU cores
# with the 30-min timeout above. Check the "Nx realtime" line whisper logs on success and
# retune from that; 0 disables the cap.
ASR_MAX_DURATION_SEC="1200"
# whisper.cpp defaults both to 5, i.e. beam search with 5 decoder passes. Its strategy is
# `beam_size > 1 ? BEAM_SEARCH : GREEDY`, so 1 here is what buys greedy decoding — several
# times faster on CPU for a modest accuracy cost. Set both to 5 to restore upstream behaviour.
ASR_BEAM_SIZE="1"
ASR_BEST_OF="1"
# whisper.cpp's own default is min(4, cores), so this only matters above 4 cores. Blank =
# os.availableParallelism(). That reads the CPU affinity mask and CANNOT see Docker's --cpus
# quota, so pin it explicitly if you ever add a cpus: limit.
ASR_THREADS=""
# "true" restores the old behaviour of running ASR even when captions failed only because
# YouTube rate-limited us. Off by default: a 429 says nothing about whether captions exist,
# so the right move is to retry later, not to transcribe half an hour of audio.
ASR_ON_RATE_LIMIT="false"

# --- yt-dlp tuning / rate-limit defenses ---
YTDLP_SUB_LANGS="en,zh-TW,zh-Hant,zh,ja"
YTDLP_MIN_GAP_MS="2000"
YTDLP_MAX_RETRIES="4"
YTDLP_BACKOFF_MS="3000"
YTDLP_SLEEP_REQUESTS="1"
YTDLP_SLEEP_SUBTITLES="2"
YTDLP_RETRIES="5"
YTDLP_EXTRACTOR_RETRIES="3"
YTDLP_PLAYER_CLIENT=""
YTDLP_COOKIES=""
YTDLP_COOKIES_FROM_BROWSER=""
YTDLP_MAX_TRANSCRIPT_CHARS="100000"
# Process-wide cooldown once YouTube has actually throttled us. MIN_GAP_MS paces the happy
# path; this is the longer window every in-flight job waits out, so one job's 429 slows all
# WORKER_CONCURRENCY of them. Doubles per fresh 429 up to the max, and clears on any success.
YTDLP_COOLDOWN_MS="60000"
YTDLP_COOLDOWN_MAX_MS="600000"
# The caption stage asks the metadata JSON which languages exist and requests exactly one,
# instead of one timedtext request per configured language. Set "false" if a player client
# starts returning info JSON with empty caption maps for videos that do have captions —
# trusting that would silently turn every job into an ASR job.
YTDLP_TRUST_CAPTION_METADATA="true"

# --- Left blank ON PURPOSE below this line ---
# These three are the ones where "" means DISABLED, not "use the default": src/config.js
# reads them with ?? so an empty string in .env overrides the code default. Uncomment only
# to change them, and note what you lose by blanking them out:
#   YTDLP_JS_RUNTIMES            default "node" — without it YouTube's player challenge goes
#                                unsolved and yt-dlp falls back to a degraded client
#                                ("some formats may be missing" / "Requested format is not
#                                available"). Set "node:/usr/bin/node" if node isn't on PATH.
#   YTDLP_PLAYER_CLIENT_FALLBACKS default "tv,web_safari,ios" — blanking it means the audio
#                                download tries exactly one client and never retries.
# YTDLP_JS_RUNTIMES="node"
# YTDLP_PLAYER_CLIENT_FALLBACKS="tv,web_safari,ios"
# Opt-in only: makes yt-dlp FETCH AND EXECUTE JavaScript from GitHub. Needed only if your
# yt-dlp build ships without the bundled EJS scripts.
YTDLP_REMOTE_COMPONENTS=""
